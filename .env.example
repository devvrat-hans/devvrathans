# Copy to .env.local (gitignored) and fill in what you use. Every value is optional:
# without one, the build skips that step and ships the last cached data.

# GitHub heatmap snapshot at build time. Classic PAT with read:user scope.
GITHUB_TOKEN=

# Notes from Notion (scripts/sync-notion-notes.mjs, runs on every build and `bun run notes:sync`).
# To have notes publish themselves, the same two values also go into GitHub secrets (DEPLOY.md).
# Internal integration secret from https://www.notion.so/profile/integrations (starts with ntn_).
NOTION_TOKEN=
# The notes database: paste its id or its full URL. Share the database with the integration first.
NOTION_NOTES_DATABASE_ID=

# Newsletter form endpoint. Leave empty in production (same-origin /api/newsletter, served by the
# Worker). For local testing with `bun run worker:dev`, use:
# NEXT_PUBLIC_NEWSLETTER_URL=http://localhost:8787/api/newsletter
NEXT_PUBLIC_NEWSLETTER_URL=
